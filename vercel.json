{
  "version": 2,
  "framework": null,
  "installCommand": "npx pnpm@9 install --no-frozen-lockfile",
  "buildCommand": "npx pnpm@9 --filter @workspace/api-server run build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}