{
  "version": 2,
  "installCommand": "npx pnpm@9 install --no-frozen-lockfile",
  "buildCommand": "npx pnpm@9 run build",
  "functions": {
    "dist/index.mjs": {
      "runtime": "@vercel/node@3.2.24"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/dist/index.mjs"
    }
  ]
}
