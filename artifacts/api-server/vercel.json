{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npx pnpm@9 install --no-frozen-lockfile",
  "buildCommand": "npx pnpm@9 --filter @workspace/api-server run build",
  "functions": {
    "dist/index.mjs": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.mjs"
    }
  ]
}